# ---------- Resend ----------
# Chave da API do Resend. NUNCA comitar a chave real — preencher no Railway.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Remetente. O dominio precisa estar verificado no Resend.
LEAD_FROM="Site Azuton <noreply@azuton.com>"

# Destino padrao dos leads. Aceita varios e-mails separados por virgula.
LEAD_TO=marketing@azuton.com,comercial@azuton.com

# Destino do formulario de portabilidade (as duas versoes da pagina, nos tres
# idiomas). Sem esta variavel, a portabilidade cai no LEAD_TO.
LEAD_TO_PORTABILIDADE=suporte.voz@azuton.com

# Copia oculta (opcional).
# LEAD_BCC=diretoria@azuton.com

# Quando true, o "Responder" do e-mail vai direto para o lead.
LEAD_REPLY_TO_LEAD=true

# ---------- Servidor ----------
PORT=3000

# Dominio publico, usado no sitemap, no canonical e nas tags hreflang.
SITE_URL=https://azuton.com

# ---------- Fallback ----------
# WhatsApp usado quando o envio por e-mail falha (somente digitos).
WHATSAPP_FALLBACK=551151520050
